### -------------------------------------------------------------------------
### LLM backend selection
### -------------------------------------------------------------------------
# Which backend the pipeline talks to. Default: gcloud-anthropic (Vertex AI).
#   API backends : anthropic | openai | gcloud-anthropic
#   agent CLIs   : claude_cli | agy_cli | gemini_cli | cli   (no API key —
#                  they use your own Claude / Google / Gemini subscription)
# NEO_LLM_PROVIDER="gcloud-anthropic"
# NEO_LLM_MODEL=""            # optional; blank = provider/CLI default

### API keys (needed only for the API backends)
OPENAI_API_KEY="xxx"
ANTHROPIC_API_KEY="xxx"

### gcloud-anthropic (Vertex AI)
# Absolute path to a Google Cloud service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS="/abs/path/to/service-account.json"
# Google Cloud project that has Vertex AI + the Anthropic models enabled.
VERTEX_PROJECT_ID="your-gcp-project-id"
# Optional: Vertex AI region (default: us-east5).
# VERTEX_LOCATION="us-east5"

### agent-CLI backends (NEO_LLM_PROVIDER=claude_cli | agy_cli | gemini_cli | cli)
# The named providers just need the CLI on PATH:
#   claude_cli -> `claude`   agy_cli -> `agy`   gemini_cli -> `gemini`
# Generic escape hatch (NEO_LLM_PROVIDER=cli):
# LLM_CLI_COMMAND="claude --print --output-format json"
# LLM_CLI_PARSER="claude-json"        # or: text
# LLM_CLI_TIMEOUT=600
# Tip: agent CLIs are stateless per call and can hit subscription rate limits —
#      set MAX_CONCURRENT_GROUPS=1 for --validate-flows.

### --agent (code-search agent loop)
# The agent's fallback tool is a sandboxed, read-only shell (grep/find/ls/
# cat/...) scoped to a service's source tree, for when qname/qast/qflow can't
# name what it's looking for. Set to "0" to disable it entirely.
# NEO_AGENT_BASH="1"

### codeql dependencies
CODEQL_BIN="/abs/path/to/codeql/binary"
CODEQL_TIMEOUT=300

# Optional: path to library semantics JSON index (default: src/data/library_semantics.json)
# LIBRARY_SEMANTICS_PATH="/abs/path/to/library_semantics.json"
